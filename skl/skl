#!/usr/bin/env python3
"""Development launcher: run skl straight from a checkout (the installer builds a single file)."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from sklcli.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
