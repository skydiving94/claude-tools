#!/usr/bin/env python3
from __future__ import annotations

import re
import sys


class SklError(Exception):
    """General failure: exit 1, printed as 'error: <msg>'."""


class UsageError(SklError):
    """Usage failure: exit 2, optionally carrying a usage line."""

    def __init__(self, msg, usage_line=None):
        super().__init__(msg)
        self.usage_line = usage_line


_HEADING_RE = re.compile(r"^##\s+Command interface", re.IGNORECASE)
_FENCE_RE = re.compile(r"^(```|~~~)")
_ACTION_NAME_RE = re.compile(r"^[a-z][a-z0-9-]*$")


def _normalise(text):
    return text.replace("\r\n", "\n").replace("\r", "\n")


def extract_block(skill_md):
    lines = _normalise(skill_md).split("\n")
    start = None
    for i, line in enumerate(lines):
        if _HEADING_RE.match(line):
            start = i + 1
            break
    if start is None:
        return None
    opened = None
    body = []
    for line in lines[start:]:
        if opened is None:
            if line.startswith("## "):
                return None
            if _FENCE_RE.match(line):
                opened = line[:3]
        elif line.startswith(opened):
            return "\n".join(body)
        else:
            body.append(line)
    return None


def frontmatter_name(skill_md):
    lines = _normalise(skill_md).split("\n")
    if not lines or lines[0].strip() != "---":
        return None
    for line in lines[1:]:
        if line.strip() == "---":
            return None
        m = re.match(r"^name:\s*(.*?)\s*$", line)
        if m:
            value = m.group(1)
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                value = value[1:-1]
            return value or None
    return None


def _parse_action_line(line):
    words = line.split()
    if not words or not _ACTION_NAME_RE.match(words[0]):
        return None
    targets = []
    i = 1
    while i < len(words):
        w = words[i]
        m = re.match(r"^<([^<>]+)>$", w)
        o = re.match(r"^\[<([^<>]+)>\]$", w)
        if m:
            targets.append({"name": m.group(1), "required": True})
        elif o:
            targets.append({"name": o.group(1), "required": False})
        else:
            break
        i += 1
    # description: remainder of the line after the consumed words
    rest = line.strip()
    for w in words[:i]:
        rest = rest[len(w):].lstrip() if rest.startswith(w) else rest
    return words[0], {"targets": targets, "description": rest.strip()}


_GROUP_RE = re.compile(r"^\s*([A-Za-z][^:]*?):\s*(.*)$")
_FLAG_RE = re.compile(r"^--?[A-Za-z][A-Za-z0-9-]*$")
_CHOICE_RE = re.compile(r"^[A-Za-z0-9_-]+$")
_TOKEN_RE = re.compile(r'"[^"]*"|\S+')


def _split_actions(text, known):
    pieces = [p.strip() for p in re.split(r"[/,]", text)]
    if pieces and all(p in known for p in pieces):
        return pieces
    return None


def _label_actions(label, known):
    if label.strip().lower() == "global":
        return None
    m = re.search(r"\(([^)]*)\)", label)
    if m:
        found = _split_actions(m.group(1), known)
        if found is not None:
            return found
    return _split_actions(label, known)


def _parse_flags(text):
    text = re.sub(r"\([^)]*\)", " ", text)
    tokens = _TOKEN_RE.findall(text)
    flags = []
    i = 0
    alias = False
    while i < len(tokens):
        tok = tokens[i]
        if tok == "|":
            alias = bool(flags)
        elif _FLAG_RE.match(tok):
            if alias and flags:
                flags[-1]["names"].append(tok)
            else:
                flags.append({"names": [tok], "takes_value": False, "choices": []})
            alias = False
            nxt = tokens[i + 1] if i + 1 < len(tokens) else ""
            if nxt.startswith("<") or nxt.startswith('"<'):
                flag = flags[-1]
                flag["takes_value"] = True
                if nxt.startswith("<") and nxt.endswith(">"):
                    parts = nxt[1:-1].split("|")
                    if len(parts) >= 2 and all(_CHOICE_RE.match(p) for p in parts):
                        flag["choices"] = parts
                i += 1
        else:
            alias = False
        i += 1
    return flags


def parse_interface(block):
    lines = _normalise(block).split("\n")
    usage_line = None
    for line in lines:
        if line.startswith("/"):
            usage_line = line.strip()
            break
    actions = {}
    in_section = False
    rest_start = len(lines)
    for idx, line in enumerate(lines):
        if not in_section:
            if line.startswith("Actions"):
                in_section = True
            continue
        if not line.strip() or not line[0].isspace():
            rest_start = idx
            break
        parsed = _parse_action_line(line)
        if parsed:
            actions[parsed[0]] = parsed[1]
    if not actions:
        return None
    groups = []
    current = None
    for line in lines[rest_start:]:
        m = _GROUP_RE.match(line)
        if m and "--" not in m.group(1):
            label = m.group(1).strip()
            current = {"label": label, "actions": _label_actions(label, actions), "_text": [m.group(2)]}
            groups.append(current)
        elif current is not None and line[:1].isspace() and line.strip().startswith("-"):
            current["_text"].append(line)
    for g in groups:
        g["flags"] = _parse_flags("\n".join(g.pop("_text")))
    return {"usage_line": usage_line, "actions": actions, "groups": groups}


def flags_for(interface, action):
    out = []
    seen = set()
    for g in interface["groups"]:
        if g["actions"] is not None and action not in g["actions"]:
            continue
        for f in g["flags"]:
            if f["names"][0] not in seen:
                seen.add(f["names"][0])
                out.append(f)
    return out


def all_flag_names(interface):
    return {n for g in interface["groups"] for f in g["flags"] for n in f["names"]}


def main(argv):
    sys.stderr.write("error: unknown command\n")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
