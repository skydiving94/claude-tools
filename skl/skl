def store_dir():
    base = os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local" / "share")
    return Path(base) / "skl"


def _valid_interface(iface):
    if iface is None:
        return True
    if not isinstance(iface, dict) or not all(k in iface for k in ("usage_line", "actions", "groups")):
        return False
    if not isinstance(iface["actions"], dict) or not isinstance(iface["groups"], list):
        return False
    if not all(isinstance(a, dict) and isinstance(a.get("targets"), list)
               for a in iface["actions"].values()):
        return False
    return all(isinstance(g, dict) and isinstance(g.get("flags"), list) for g in iface["groups"])


def _valid_entry(key, entry):
    return (isinstance(key, str) and _NAME_RE.fullmatch(key) is not None
            and isinstance(entry, dict)
            and isinstance(entry.get("name"), str) and _NAME_RE.fullmatch(entry["name"]) is not None
            and isinstance(entry.get("usage_block"), str)
            and entry.get("source") in ("sync", "import")
            and _valid_interface(entry.get("interface", False)))


def load_index(dropped=None):
    """Load the index, silently dropping invalid entries.

    If a list is passed as `dropped`, the keys of dropped entries are appended to it.
    """
    path = store_dir() / "index.json"
    try:
        text = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return {"version": 1, "skills": {}}
    except (OSError, UnicodeDecodeError):
        raise SklError("index is unreadable, run 'skl sync'")
    try:
        data = json.loads(text)
    except ValueError:
        raise SklError("index is unreadable, run 'skl sync'")
    if not isinstance(data, dict) or not isinstance(data.get("skills"), dict):
        raise SklError("index is unreadable, run 'skl sync'")
    good = {}
    for key, entry in data["skills"].items():
        if _valid_entry(key, entry):
            good[key] = entry
        elif dropped is not None:
            dropped.append(key)
    data["skills"] = good
    return data


def save_index(index):
    d = store_dir()
    d.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".index-", suffix=".tmp", dir=str(d))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(index, f, indent=2)
            f.write("\n")
        os.replace(tmp, str(d / "index.json"))
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def _skill_folder(name):
    if not _NAME_RE.fullmatch(name):
        raise SklError("unsafe skill name '%s'" % name)
    return store_dir() / "skills" / name


def _entry_from_bytes(data, fallback_name, source, source_path):
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        raise SklError("not valid UTF-8")
    block = extract_block(text)
    if block is None:
        raise NoInterfaceError("no command interface block")
    interface = parse_interface(block)
    name = frontmatter_name(text)
    if not name:
        usage = (interface or {}).get("usage_line") or ""
        first = usage.split()[0].lstrip("/") if usage.split() else ""
        name = first or fallback_name
    if not _NAME_RE.fullmatch(name or ""):
        raise SklError("unsafe skill name '%s'" % name)
    return {"name": name, "source": source, "source_path": str(source_path),
            "usage_block": block, "interface": interface}


def make_entry(skill_md_path, source):
    path = Path(skill_md_path)
    try:
        data = path.read_bytes()
    except OSError as e:
        raise SklError("cannot read: %s" % (e.strerror or e))
    return _entry_from_bytes(data, path.parent.name, source, path)


def _write_store(name, data):
    folder = _skill_folder(name)
    folder.mkdir(parents=True, exist_ok=True)
    (folder / "SKILL.md").write_bytes(data)


def _drop_store(name):
    shutil.rmtree(str(_skill_folder(name)), ignore_errors=True)


def scan_roots(cwd):
    cwd = Path(cwd).resolve()
    roots = [Path.home() / ".claude" / "skills"]
    top = None
    for d in [cwd] + list(cwd.parents):
        if (d / ".git").exists():
            top = d
            break
    if top is None:
        chain = [cwd]
    else:
        chain = [cwd]
        while chain[0] != top:
            chain.insert(0, chain[0].parent)
    roots.extend(d / ".claude" / "skills" for d in chain)
    for p in os.environ.get("SKL_SKILL_PATH", "").split(os.pathsep):
        if p:
            roots.append(Path(p))
    out = []
    seen = set()
    for r in roots:
        if r.is_dir():
            key = str(r.resolve())
            if key not in seen:
                seen.add(key)
                out.append(r)
    return out


def get_entry(index, name):
    skills = index["skills"]
    if name in skills:
        return skills[name]
    msg = "unknown skill '%s'" % name
    close = difflib.get_close_matches(name, list(skills), n=3)
    if not skills:
        msg += "\nrun 'skl sync' to index your skills"
    elif close:
        msg += "\ndid you mean: %s" % ", ".join(close)
    raise UsageError(msg)


def _out(line):
    sys.stdout.write(line + "\n")


def _describe(entry):
    if entry["interface"] is None:
        return "(pass-through)"
    return ", ".join(entry["interface"]["actions"])


def cmd_sync(args):
    if args:
        raise UsageError("sync takes no arguments")
    dropped = []
    try:
        index = load_index(dropped)
    except SklError:
        sys.stderr.write("note: index was unreadable, rebuilding it\n")
        index = {"version": 1, "skills": {}}
    for key in dropped:
        _out("note: dropped invalid index entry %s" % key)
    skills = index["skills"]
    seen = set()
    for root in scan_roots(Path.cwd()):
        for path in sorted(root.rglob("SKILL.md")):
            if not path.is_file():
                continue
            try:
                with open(str(path), "rb") as f:
                    data = f.read(_MAX_SKILL_BYTES + 1)
                if len(data) > _MAX_SKILL_BYTES:
                    sys.stderr.write("skipped %s: too large\n" % path)
                    continue
                entry = _entry_from_bytes(data, path.parent.name, "sync", path)
            except NoInterfaceError:
                continue
            except SklError as e:
                sys.stderr.write("skipped %s: %s\n" % (path, e))
                continue
            except OSError as e:
                sys.stderr.write("skipped %s: %s\n" % (path, e.strerror or e))
                continue
            name = entry["name"]
            old = skills.get(name)
            if old is not None and old.get("source") == "import" and name not in seen:
                _out("note: %s ignored, imported %s kept" % (path, name))
                continue
            if old is not None and name in seen:
                _out("note: %s from %s replaces %s" % (name, path, old.get("source_path")))
            _write_store(name, data)
            skills[name] = entry
            seen.add(name)
            n = len(entry["interface"]["actions"]) if entry["interface"] else None
            _out("indexed %s (%s)" % (name, "pass-through" if n is None else "%d actions" % n))
    for name in sorted(skills):
        if skills[name].get("source") == "sync" and name not in seen:
            del skills[name]
            _drop_store(name)
            _out("removed %s" % name)
    save_index(index)
    _out("%d skills indexed" % len(skills))
    return 0


def _read_skill_source(p):
    """Return (bytes, fallback_name) for a SKILL.md, a folder, or a zip."""
    if p.is_dir():
        f = p / "SKILL.md"
        if not f.is_file():
            raise SklError("no SKILL.md in %s" % p)
        return f.read_bytes(), p.resolve().name
    if not p.exists():
        raise SklError("no such file: %s" % p)
    if p.suffix.lower() in (".skill", ".zip"):
        try:
            zf = zipfile.ZipFile(str(p))
        except zipfile.BadZipFile:
            raise SklError("not a valid zip file: %s" % p)
        with zf:
            try:
                names = zf.namelist()
                member = None
                if "SKILL.md" in names:
                    member = "SKILL.md"
                else:
                    for n in names:
                        parts = n.split("/")
                        if len(parts) == 2 and parts[1] == "SKILL.md" and parts[0] not in ("", ".", ".."):
                            member = n
                            break
                if member is None:
                    raise SklError("no SKILL.md in %s" % p)
                if zf.getinfo(member).file_size > _MAX_SKILL_BYTES:
                    raise SklError("SKILL.md in %s is too large" % p)
                fallback = member.split("/")[0] if "/" in member else p.stem
                return zf.read(member), fallback
            except (zipfile.BadZipFile, zlib.error, RuntimeError, NotImplementedError, EOFError) as e:
                raise SklError("cannot read %s: %s" % (p, e))
    return p.read_bytes(), p.resolve().parent.name


def cmd_import(args):
    if len(args) != 1:
        raise UsageError("usage: skl import <path>")
    p = Path(args[0])
    data, fallback = _read_skill_source(p)
    entry = _entry_from_bytes(data, fallback, "import", p.resolve())
    index = load_index()
    _write_store(entry["name"], data)
    index["skills"][entry["name"]] = entry
    save_index(index)
    _out("imported %s" % entry["name"])
    return 0


def cmd_list(args):
    if args:
        raise UsageError("list takes no arguments")
    skills = load_index()["skills"]
    if not skills:
        _out("no skills indexed, run 'skl sync'")
        return 0
    for name in sorted(skills):
        _out("%s\t%s" % (name, _describe(skills[name])))
    return 0


def cmd_show(args):
    parsed = "--parsed" in args
    rest = [a for a in args if a != "--parsed"]
    if len(rest) != 1:
        raise UsageError("usage: skl show <skill> [--parsed]")
    entry = get_entry(load_index(), rest[0])
    if parsed:
        _out(json.dumps(entry["interface"], indent=2))
    else:
        sys.stdout.write(entry["usage_block"])
        if not entry["usage_block"].endswith("\n"):
            sys.stdout.write("\n")
    return 0


def cmd_remove(args):
    if len(args) != 1:
        raise UsageError("usage: skl remove <skill>")
    index = load_index()
    entry = get_entry(index, args[0])
    name = entry["name"] if entry.get("name") in index["skills"] else args[0]
    del index["skills"][name]
    _drop_store(name)
    save_index(index)
    _out("removed %s" % name)
    if entry.get("source") == "sync":
        _out("note: 'skl sync' will add it back while the source exists")
    return 0


_SAFE_ARG_RE = re.compile(r"^[A-Za-z0-9_@%+=:,./-]+$")


def quote_arg(arg):
    if _SAFE_ARG_RE.match(arg):
        return arg
    return '"%s"' % arg.replace("\\", "\\\\").replace('"', '\\"')


def build_command(name, args):
    return "/" + name + "".join(" " + quote_arg(a) for a in args)


def split_mode(entry, args):
    interface = entry.get("interface")
    taken = set(all_flag_names(interface)) if interface else set()
    flags = {}
    rest = []
    for a in args:
        for mode in ("print", "app"):
            plain, prefixed = "--" + mode, "--skl-" + mode
            if a == prefixed or (a == plain and plain not in taken):
                flags[mode] = True
                break
        else:
            rest.append(a)
    if len(flags) == 2:
        raise UsageError("choose one of --print and --app")
    return (next(iter(flags)) if flags else "terminal"), rest


def app_url(command):
    return "https://claude.ai/new?q=" + urllib.parse.quote(command, safe="")


_HELP_HINT = "run 'skl help' to see the commands"
_HELP_FLAGS = ("--help", "-h")


def _help_screen():
    try:
        skills = load_index()["skills"]
    except Exception:
        skills = {}
    lines = ["skl %s - run command-style Claude skills from your shell" % __version__, "",
             "Usage:", "  skl <command> [args]",
             "  skl <skill> <action> [<target>] [options] [--print | --app]", "", "Commands:"]
    lines += ["  %-23s %s" % (usage, summary) for _n, usage, summary, _d in _COMMANDS_HELP]
    lines += ["", "Run options:",
              "  --print      Run non-interactively (claude -p) and print the result",
              "  --app        Open claude.ai in the browser with the command filled in",
              "  --help, -h   Show help (after a skill name: that skill's usage block)",
              "  --version    Show the version", "",
              "Environment:",
              "  SKL_SKILL_PATH   Extra skill folders to scan (separated like PATH)",
              "  XDG_DATA_HOME    Where skl keeps its index (default ~/.local/share)", "",
              "Indexed skills:"]
    if skills:
        width = max(len(n) for n in skills) + 3
        for name in sorted(skills):
            try:
                lines.append("  %s%s" % (name.ljust(width), _describe(skills[name])))
            except Exception:
                lines.append("  %s" % name)
    else:
        lines.append("  none indexed, run 'skl sync'")
    return "\n".join(lines) + "\n"


def _command_help(name):
    for cname, usage, _summary, description in _COMMANDS_HELP:
        if cname == name:
            return "usage: skl %s\n\n%s\n" % (usage, description)
    raise UsageError("unknown command '%s'\n%s" % (name, _HELP_HINT))


def cmd_help(args):
    if not args:
        sys.stdout.write(_help_screen())
    elif len(args) == 1:
        sys.stdout.write(_command_help("help" if args[0] in _HELP_FLAGS else args[0]))
    else:
        raise UsageError("usage: skl help [<command>]")
    return 0


def cmd_run(args):
    if not args:
        raise UsageError("usage: skl run <skill> [args...]")
    entry = get_entry(load_index(), args[0])
    mode, rest = split_mode(entry, args[1:])
    if "--help" in rest or "-h" in rest:
        sys.stdout.write(entry["usage_block"])
        if not entry["usage_block"].endswith("\n"):
            sys.stdout.write("\n")
        return 0
    try:
        validate(entry, rest)
    except UsageError as e:
        sys.stderr.write("error: %s\n" % e)
        if e.usage_line:
            sys.stderr.write("usage: %s\n" % e.usage_line)
        return 2
    command = build_command(entry["name"], rest)
    if mode == "app":
        url = app_url(command)
        sys.stderr.write("opening %s\n" % url)
        opener = "open" if sys.platform == "darwin" else "xdg-open"
        if shutil.which(opener):
            subprocess.call([opener, url])
        else:
            _out(url)
        return 0
    if not shutil.which("claude"):
        sys.stderr.write("error: claude CLI not found, install Claude Code or use --app\n")
        return 127
    sys.stdout.flush()
    sys.stderr.flush()
    argv = ["claude", "-p", command] if mode == "print" else ["claude", command]
    try:
        os.execvp("claude", argv)
    except OSError as e:
        sys.stderr.write("error: %s\n" % (e.strerror or e))
        return 1
    return 0


def cmd_doctor(args):
    if args:
        raise UsageError("doctor takes no arguments")
    claude = shutil.which("claude")
    _out("claude: %s" % (claude or "not found"))
    version = "unknown"
    signin = "not confirmed (run `claude` once to sign in)"
    if claude:
        try:
            r = subprocess.run(["claude", "--version"], capture_output=True, text=True, timeout=10,
                               stdin=subprocess.DEVNULL)
            lines = r.stdout.strip().splitlines()
            if lines:
                version = lines[0]
        except (OSError, subprocess.SubprocessError, ValueError):
            pass
        try:
            r = subprocess.run(["claude", "auth", "status"], capture_output=True, timeout=10,
                               stdin=subprocess.DEVNULL)
            if r.returncode == 0:
                signin = "ok"
        except (OSError, subprocess.SubprocessError):
            pass
    _out("version: %s" % version)
    _out("sign-in: %s" % signin)
    _out("store: %s" % store_dir())
    skills = load_index()["skills"]
    passthrough = sum(1 for e in skills.values() if e.get("interface") is None)
    _out("skills: %d indexed (%d pass-through)" % (len(skills), passthrough))
    roots = scan_roots(os.getcwd())
    if roots:
        _out("roots:")
        for r in roots:
            _out("  %s" % r)
    else:
        _out("roots: none found")
    return 0 if claude else 1


def _filter(prefix, pairs):
    return [(c, d) for c, d in pairs if c.startswith(prefix)]


def _skill_line(entry, words):
    cur = words[-1]
    interface = entry.get("interface")
    taken = all_flag_names(interface) if interface else set()
    extras = []
    for mode in ("print", "app"):
        extras.append("--skl-" + mode if "--" + mode in taken else "--" + mode)
    if len(words) == 1:
        if interface is None:
            return _filter(cur, [("--help", ""), ("--print", ""), ("--app", "")])
        return _filter(cur, [(n, a.get("description", "")) for n, a in interface["actions"].items()])
    if interface is None or words[0] not in interface["actions"]:
        return []
    action = words[0]
    flags = flags_for(interface, action)
    if len(words) >= 3:
        prev = words[-2]
        for f in flags:
            if prev in f["names"] and f["takes_value"]:
                return _filter(cur, [(ch, "") for ch in f.get("choices", [])])
    earlier = set(words[1:-1])
    out = [(f["names"][0], "") for f in flags if not earlier.intersection(f["names"])]
    out += [(x, "") for x in extras if x not in earlier]
    return _filter(cur, out)


def complete(index, words):
    skills = index.get("skills", {})
    if not words:
        return []
    cur = words[-1]
    if len(words) == 1:
        return _filter(cur, [(b, "") for b in _BUILTINS] + [(n, "") for n in sorted(skills)])
    first = words[0]
    if first == "help":
        return _filter(cur, [(b, "") for b in _BUILTINS]) if len(words) == 2 else []
    if first in ("show", "remove", "run") and len(words) == 2:
        return _filter(cur, [(n, "") for n in sorted(skills)])
    if first == "completion":
        return _filter(cur, [("zsh", ""), ("bash", "")]) if len(words) == 2 else []
    if first == "run":
        first, words = words[1], words[1:]
        if first not in skills:
            return []
        return _skill_line(skills[first], words[1:])
    if first in _BUILTINS:
        return []
    if first in skills:
        return _skill_line(skills[first], words[1:])
    return []


def cmd_complete(args):
    try:
        words = args[1:] if args and args[0] == "--" else args
        try:
            index = load_index()
        except Exception:
            index = {"skills": {}}
        pairs = complete(index, list(words))
        sys.stdout.write("".join(c + ("\t" + d if d else "") + "\n" for c, d in pairs))
        sys.stdout.flush()
    except Exception:
        pass
    return 0


BASH_COMPLETION = """\
# skl completion for bash
_skl_complete() {
  local name rest
  COMPREPLY=()
  while IFS=$'\\t' read -r name rest; do
    if [ -n "$name" ]; then COMPREPLY+=("$name"); fi
  done < <(skl __complete -- "${COMP_WORDS[@]:1:COMP_CWORD}" 2>/dev/null)
}
complete -o default -F _skl_complete skl
"""

ZSH_COMPLETION = """\
#compdef skl
_skl() {
  local -a out cands
  local line name desc
  out=("${(@f)$(skl __complete -- "${(@)words[2,CURRENT]}" 2>/dev/null)}")
  for line in $out; do
    [[ -z $line ]] && continue
    name=${line%%$'\\t'*}
    desc=""
    [[ $line == *$'\\t'* ]] && desc=${line#*$'\\t'}
    name=${name//:/\\\\:}
    if [[ -n $desc ]]; then cands+=("$name:$desc"); else cands+=("$name"); fi
  done
  if (( ${#cands} )); then _describe -t skl 'skl' cands; else _files; fi
}
if [[ $funcstack[1] == _skl ]]; then _skl "$@"; else compdef _skl skl; fi
"""


def cmd_completion(args):
    if len(args) != 1 or args[0] not in ("bash", "zsh"):
        raise UsageError("choose zsh or bash")
    sys.stdout.write(BASH_COMPLETION if args[0] == "bash" else ZSH_COMPLETION)
    return 0


_COMMANDS = {"sync": cmd_sync, "import": cmd_import, "list": cmd_list,
             "show": cmd_show, "remove": cmd_remove, "doctor": cmd_doctor, "run": cmd_run,
             "completion": cmd_completion, "help": cmd_help}


def main(argv):
    try:
        if argv and argv[0] == "__complete":
            return cmd_complete(argv[1:])
        if not argv or argv in (["--help"], ["-h"]):
            sys.stdout.write(_help_screen())
            return 0
        if argv[0] in _COMMANDS:
            rest = argv[1:]
            # 'run <skill> ... --help' belongs to the skill; only a bare 'run --help' is run's help.
            wants_help = (rest[0] in _HELP_FLAGS if argv[0] == "run" and len(rest) == 1
                          else argv[0] != "run" and any(a in _HELP_FLAGS for a in rest))
            if wants_help and argv[0] != "help":
                sys.stdout.write(_command_help(argv[0]))
                return 0
            return _COMMANDS[argv[0]](rest)
        return cmd_run(argv)
    except KeyboardInterrupt:
        return 130
    except UsageError as e:
        sys.stderr.write("error: %s\n" % e)
        return 2
    except (SklError, OSError) as e:
        if isinstance(e, OSError) and not isinstance(e, SklError):
            e = e.strerror or e
        sys.stderr.write("error: %s\n" % e)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
