#!/usr/bin/env python3
from __future__ import annotations

import difflib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.parse
import zipfile
import zlib
from pathlib import Path


class SklError(Exception):
    """General failure: exit 1, printed as 'error: <msg>'."""


class UsageError(SklError):
    """Usage failure: exit 2, optionally carrying a usage line."""

    def __init__(self, msg, usage_line=None):
        super().__init__(msg)
        self.usage_line = usage_line


class NoInterfaceError(SklError):
    """The file has no command interface block."""


_HEADING_RE = re.compile(r"^##\s+Command interface", re.IGNORECASE)
_FENCE_RE = re.compile(r"^(```|~~~)")
_ACTION_NAME_RE = re.compile(r"^[a-z][a-z0-9-]*$")


def _normalise(text):
    return text.replace("\r\n", "\n").replace("\r", "\n")


def extract_block(skill_md):
    lines = _normalise(skill_md).split("\n")
    start = None
    for i, line in enumerate(lines):
        if _HEADING_RE.match(line):
            start = i + 1
            break
    if start is None:
        return None
    opened = None
    body = []
    for line in lines[start:]:
        if opened is None:
            if line.startswith("## "):
                return None
            if _FENCE_RE.match(line):
                opened = line[:3]
        elif line.startswith(opened):
            return "\n".join(body)
        else:
            body.append(line)
    return None


def frontmatter_name(skill_md):
    lines = _normalise(skill_md).split("\n")
    if not lines or lines[0].strip() != "---":
        return None
    for line in lines[1:]:
        if line.strip() == "---":
            return None
        m = re.match(r"^name:\s*(.*?)\s*$", line)
        if m:
            value = m.group(1)
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                value = value[1:-1]
            return value or None
    return None


def _parse_action_line(line):
    words = line.split()
    if not words or not _ACTION_NAME_RE.fullmatch(words[0]):
        return None
    targets = []
    i = 1
    while i < len(words):
        w = words[i]
        m = re.match(r"^<([^<>]+)>$", w)
        o = re.match(r"^\[<([^<>]+)>\]$", w)
        if m:
            targets.append({"name": m.group(1), "required": True})
        elif o:
            targets.append({"name": o.group(1), "required": False})
        else:
            break
        i += 1
    # description: remainder of the line after the consumed words
    rest = line.strip()
    for w in words[:i]:
        rest = rest[len(w):].lstrip() if rest.startswith(w) else rest
    return words[0], {"targets": targets, "description": rest.strip()}


_GROUP_RE = re.compile(r"^\s*([A-Za-z][^:]*?):\s*(.*)$")
_FLAG_RE = re.compile(r"^--?[A-Za-z][A-Za-z0-9-]*$")
_CHOICE_RE = re.compile(r"^[A-Za-z0-9_-]+$")
_TOKEN_RE = re.compile(r'"[^"]*"|\S+')


def _split_actions(text, known):
    pieces = [p.strip() for p in re.split(r"[/,]", text)]
    if pieces and all(p in known for p in pieces):
        return pieces
    return None


def _label_actions(label, known):
    if label.strip().lower() == "global":
        return None
    m = re.search(r"\(([^)]*)\)", label)
    if m:
        found = _split_actions(m.group(1), known)
        if found is not None:
            return found
    return _split_actions(label, known)


def _parse_flags(text):
    text = re.sub(r"\([^)]*\)", " ", text)
    tokens = _TOKEN_RE.findall(text)
    flags = []
    i = 0
    alias = False
    while i < len(tokens):
        tok = tokens[i]
        if tok == "|":
            alias = bool(flags)
        elif _FLAG_RE.match(tok):
            if alias and flags:
                flags[-1]["names"].append(tok)
            else:
                flags.append({"names": [tok], "takes_value": False, "choices": []})
            alias = False
            nxt = tokens[i + 1] if i + 1 < len(tokens) else ""
            if nxt.startswith("<") or nxt.startswith('"<'):
                flag = flags[-1]
                flag["takes_value"] = True
                if nxt.startswith("<") and nxt.endswith(">"):
                    parts = nxt[1:-1].split("|")
                    if len(parts) >= 2 and all(_CHOICE_RE.match(p) for p in parts):
                        flag["choices"] = parts
                i += 1
        else:
            alias = False
        i += 1
    return flags


def parse_interface(block):
    lines = _normalise(block).split("\n")
    usage_line = None
    for line in lines:
        if line.startswith("/"):
            usage_line = line.strip()
            break
    actions = {}
    in_section = False
    rest_start = len(lines)
    for idx, line in enumerate(lines):
        if not in_section:
            if line.startswith("Actions"):
                in_section = True
            continue
        if not line.strip() or not line[0].isspace():
            rest_start = idx
            break
        parsed = _parse_action_line(line)
        if parsed:
            actions[parsed[0]] = parsed[1]
    if not actions:
        return None
    groups = []
    current = None
    for line in lines[rest_start:]:
        m = _GROUP_RE.match(line)
        if m and "--" not in m.group(1):
            label = m.group(1).strip()
            current = {"label": label, "actions": _label_actions(label, actions), "_text": [m.group(2)]}
            groups.append(current)
        elif current is not None and line[:1].isspace() and line.strip().startswith("-"):
            current["_text"].append(line)
    for g in groups:
        g["flags"] = _parse_flags("\n".join(g.pop("_text")))
    return {"usage_line": usage_line, "actions": actions, "groups": groups}


def flags_for(interface, action):
    out = []
    seen = set()
    for g in interface["groups"]:
        if g["actions"] is not None and action not in g["actions"]:
            continue
        for f in g["flags"]:
            if f["names"][0] not in seen:
                seen.add(f["names"][0])
                out.append(f)
    return out


def all_flag_names(interface):
    return {n for g in interface["groups"] for f in g["flags"] for n in f["names"]}


_NEGATIVE_NUMBER_RE = re.compile(r"^-\d+(\.\d+)?$")


def _is_flag_arg(arg):
    return arg.startswith("-") and arg != "-" and not _NEGATIVE_NUMBER_RE.match(arg)


def validate(entry, args):
    interface = entry.get("interface")
    if interface is None:
        return
    usage = interface["usage_line"]

    def fail(msg):
        raise UsageError(msg, usage)

    actions = interface["actions"]
    if not args or _is_flag_arg(args[0]):
        fail("missing action")
    action = args[0]
    if action not in actions:
        fail("unknown action '%s'" % action)
    targets = actions[action]["targets"]
    valid = flags_for(interface, action)
    known = all_flag_names(interface)
    positionals = 0
    i = 1
    while i < len(args):
        arg = args[i]
        i += 1
        if not _is_flag_arg(arg):
            if positionals >= len(targets):
                if arg in actions:
                    fail("second action '%s'" % arg)
                fail("unexpected argument '%s'" % arg)
            positionals += 1
            continue
        name, eq, _value = arg.partition("=")
        if name not in known:
            fail("unknown flag '%s'" % name)
        flag = next((f for f in valid if name in f["names"]), None)
        if flag is None:
            fail("flag '%s' is not valid for '%s'" % (name, action))
        if flag["takes_value"]:
            if not eq:
                if i >= len(args):
                    fail("flag '%s' needs a value" % name)
                i += 1
        elif eq:
            fail("flag '%s' takes no value" % name)
    for index, target in enumerate(targets):
        if target["required"] and index >= positionals:
            fail("missing %s for '%s'" % (target["name"], action))


_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
_MAX_SKILL_BYTES = 1024 * 1024
_BUILTINS = ("sync", "import", "list", "show", "remove", "doctor", "completion", "run")


def store_dir():
    base = os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local" / "share")
    return Path(base) / "skl"


def load_index():
    path = store_dir() / "index.json"
    try:
        text = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return {"version": 1, "skills": {}}
    except (OSError, UnicodeDecodeError):
        raise SklError("index is unreadable, run 'skl sync'")
    try:
        data = json.loads(text)
    except ValueError:
        raise SklError("index is unreadable, run 'skl sync'")
    if not isinstance(data, dict) or not isinstance(data.get("skills"), dict):
        raise SklError("index is unreadable, run 'skl sync'")
    return data


def save_index(index):
    d = store_dir()
    d.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".index-", suffix=".tmp", dir=str(d))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(index, f, indent=2)
            f.write("\n")
        os.replace(tmp, str(d / "index.json"))
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def _skill_folder(name):
    if not _NAME_RE.fullmatch(name):
        raise SklError("unsafe skill name '%s'" % name)
    return store_dir() / "skills" / name


def _entry_from_bytes(data, fallback_name, source, source_path):
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        raise SklError("not valid UTF-8")
    block = extract_block(text)
    if block is None:
        raise NoInterfaceError("no command interface block")
    interface = parse_interface(block)
    name = frontmatter_name(text)
    if not name:
        usage = (interface or {}).get("usage_line") or ""
        first = usage.split()[0].lstrip("/") if usage.split() else ""
        name = first or fallback_name
    if not _NAME_RE.fullmatch(name or ""):
        raise SklError("unsafe skill name '%s'" % name)
    return {"name": name, "source": source, "source_path": str(source_path),
            "usage_block": block, "interface": interface}


def make_entry(skill_md_path, source):
    path = Path(skill_md_path)
    try:
        data = path.read_bytes()
    except OSError as e:
        raise SklError("cannot read: %s" % (e.strerror or e))
    return _entry_from_bytes(data, path.parent.name, source, path)


def _write_store(name, data):
    folder = _skill_folder(name)
    folder.mkdir(parents=True, exist_ok=True)
    (folder / "SKILL.md").write_bytes(data)


def _drop_store(name):
    shutil.rmtree(str(_skill_folder(name)), ignore_errors=True)


def scan_roots(cwd):
    cwd = Path(cwd).resolve()
    roots = [Path.home() / ".claude" / "skills"]
    top = None
    for d in [cwd] + list(cwd.parents):
        if (d / ".git").exists():
            top = d
            break
    if top is None:
        chain = [cwd]
    else:
        chain = [cwd]
        while chain[0] != top:
            chain.insert(0, chain[0].parent)
    roots.extend(d / ".claude" / "skills" for d in chain)
    for p in os.environ.get("SKL_SKILL_PATH", "").split(os.pathsep):
        if p:
            roots.append(Path(p))
    out = []
    seen = set()
    for r in roots:
        if r.is_dir():
            key = str(r.resolve())
            if key not in seen:
                seen.add(key)
                out.append(r)
    return out


def get_entry(index, name):
    skills = index["skills"]
    if name in skills:
        return skills[name]
    msg = "unknown skill '%s'" % name
    close = difflib.get_close_matches(name, list(skills), n=3)
    if close:
        msg += "\ndid you mean: %s" % ", ".join(close)
    raise UsageError(msg)


def _out(line):
    sys.stdout.write(line + "\n")


def _describe(entry):
    if entry["interface"] is None:
        return "(pass-through)"
    return ", ".join(entry["interface"]["actions"])


def cmd_sync(args):
    if args:
        raise UsageError("sync takes no arguments")
    try:
        index = load_index()
    except SklError:
        sys.stderr.write("note: index was unreadable, rebuilding it\n")
        index = {"version": 1, "skills": {}}
    skills = index["skills"]
    seen = set()
    for root in scan_roots(Path.cwd()):
        for path in sorted(root.rglob("SKILL.md")):
            try:
                entry = make_entry(path, "sync")
                data = path.read_bytes()
            except NoInterfaceError:
                continue
            except SklError as e:
                sys.stderr.write("skipped %s: %s\n" % (path, e))
                continue
            except OSError as e:
                sys.stderr.write("skipped %s: %s\n" % (path, e.strerror or e))
                continue
            name = entry["name"]
            old = skills.get(name)
            if old is not None and (name in seen or old.get("source") == "import"):
                _out("note: %s from %s replaces %s" % (name, path, old["source_path"]))
            _write_store(name, data)
            skills[name] = entry
            seen.add(name)
            n = len(entry["interface"]["actions"]) if entry["interface"] else None
            _out("indexed %s (%s)" % (name, "pass-through" if n is None else "%d actions" % n))
    for name in sorted(skills):
        if skills[name].get("source") == "sync" and name not in seen:
            del skills[name]
            _drop_store(name)
            _out("removed %s" % name)
    save_index(index)
    _out("%d skills indexed" % len(skills))
    return 0


def _read_skill_source(p):
    """Return (bytes, fallback_name) for a SKILL.md, a folder, or a zip."""
    if p.is_dir():
        f = p / "SKILL.md"
        if not f.is_file():
            raise SklError("no SKILL.md in %s" % p)
        return f.read_bytes(), p.resolve().name
    if not p.exists():
        raise SklError("no such file: %s" % p)
    if p.suffix.lower() in (".skill", ".zip"):
        try:
            zf = zipfile.ZipFile(str(p))
        except zipfile.BadZipFile:
            raise SklError("not a valid zip file: %s" % p)
        with zf:
            try:
                names = zf.namelist()
                member = None
                if "SKILL.md" in names:
                    member = "SKILL.md"
                else:
                    for n in names:
                        parts = n.split("/")
                        if len(parts) == 2 and parts[1] == "SKILL.md" and parts[0] not in ("", ".", ".."):
                            member = n
                            break
                if member is None:
                    raise SklError("no SKILL.md in %s" % p)
                if zf.getinfo(member).file_size > _MAX_SKILL_BYTES:
                    raise SklError("SKILL.md in %s is too large" % p)
                fallback = member.split("/")[0] if "/" in member else p.stem
                return zf.read(member), fallback
            except (zipfile.BadZipFile, zlib.error, RuntimeError, NotImplementedError, EOFError) as e:
                raise SklError("cannot read %s: %s" % (p, e))
    return p.read_bytes(), p.resolve().parent.name


def cmd_import(args):
    if len(args) != 1:
        raise UsageError("usage: skl import <path>")
    p = Path(args[0])
    data, fallback = _read_skill_source(p)
    entry = _entry_from_bytes(data, fallback, "import", p.resolve())
    index = load_index()
    _write_store(entry["name"], data)
    index["skills"][entry["name"]] = entry
    save_index(index)
    _out("imported %s" % entry["name"])
    return 0


def cmd_list(args):
    if args:
        raise UsageError("list takes no arguments")
    skills = load_index()["skills"]
    if not skills:
        _out("no skills indexed, run 'skl sync'")
        return 0
    for name in sorted(skills):
        _out("%s\t%s" % (name, _describe(skills[name])))
    return 0


def cmd_show(args):
    parsed = "--parsed" in args
    rest = [a for a in args if a != "--parsed"]
    if len(rest) != 1:
        raise UsageError("usage: skl show <skill> [--parsed]")
    entry = get_entry(load_index(), rest[0])
    if parsed:
        _out(json.dumps(entry["interface"], indent=2))
    else:
        sys.stdout.write(entry["usage_block"])
        if not entry["usage_block"].endswith("\n"):
            sys.stdout.write("\n")
    return 0


def cmd_remove(args):
    if len(args) != 1:
        raise UsageError("usage: skl remove <skill>")
    index = load_index()
    entry = get_entry(index, args[0])
    name = entry["name"] if entry.get("name") in index["skills"] else args[0]
    del index["skills"][name]
    _drop_store(name)
    save_index(index)
    _out("removed %s" % name)
    if entry.get("source") == "sync":
        _out("note: 'skl sync' will add it back while the source exists")
    return 0


_SAFE_ARG_RE = re.compile(r"^[A-Za-z0-9_@%+=:,./-]+$")


def quote_arg(arg):
    if _SAFE_ARG_RE.match(arg):
        return arg
    return '"%s"' % arg.replace("\\", "\\\\").replace('"', '\\"')


def build_command(name, args):
    return "/" + name + "".join(" " + quote_arg(a) for a in args)


def split_mode(entry, args):
    interface = entry.get("interface")
    taken = set(all_flag_names(interface)) if interface else set()
    flags = {}
    rest = []
    for a in args:
        for mode in ("print", "app"):
            plain, prefixed = "--" + mode, "--skl-" + mode
            if a == prefixed or (a == plain and plain not in taken):
                flags[mode] = True
                break
        else:
            rest.append(a)
    if len(flags) == 2:
        raise UsageError("choose one of --print and --app")
    return (next(iter(flags)) if flags else "terminal"), rest


def app_url(command):
    return "https://claude.ai/new?q=" + urllib.parse.quote(command, safe="")


def cmd_run(args):
    if not args:
        raise UsageError("usage: skl run <skill> [args...]")
    entry = get_entry(load_index(), args[0])
    mode, rest = split_mode(entry, args[1:])
    if "--help" in rest or "-h" in rest:
        sys.stdout.write(entry["usage_block"])
        if not entry["usage_block"].endswith("\n"):
            sys.stdout.write("\n")
        return 0
    try:
        validate(entry, rest)
    except UsageError as e:
        sys.stderr.write("error: %s\n" % e)
        if e.usage_line:
            sys.stderr.write("usage: %s\n" % e.usage_line)
        return 2
    command = build_command(entry["name"], rest)
    if mode == "app":
        url = app_url(command)
        sys.stderr.write("opening %s\n" % url)
        opener = "open" if sys.platform == "darwin" else "xdg-open"
        if shutil.which(opener):
            subprocess.call([opener, url])
        else:
            _out(url)
        return 0
    if not shutil.which("claude"):
        sys.stderr.write("error: claude CLI not found, install Claude Code or use --app\n")
        return 127
    sys.stdout.flush()
    sys.stderr.flush()
    if mode == "print":
        return subprocess.call(["claude", "-p", command])
    return subprocess.call(["claude", command])


def cmd_doctor(args):
    if args:
        raise UsageError("doctor takes no arguments")
    claude = shutil.which("claude")
    _out("claude: %s" % (claude or "not found"))
    version = "unknown"
    signin = "not confirmed (run `claude` once to sign in)"
    if claude:
        try:
            r = subprocess.run(["claude", "--version"], capture_output=True, text=True, timeout=10)
            lines = r.stdout.strip().splitlines()
            if lines:
                version = lines[0]
        except (OSError, subprocess.SubprocessError, ValueError):
            pass
        try:
            r = subprocess.run(["claude", "auth", "status"], capture_output=True, timeout=10)
            if r.returncode == 0:
                signin = "ok"
        except (OSError, subprocess.SubprocessError):
            pass
    _out("version: %s" % version)
    _out("sign-in: %s" % signin)
    _out("store: %s" % store_dir())
    skills = load_index()["skills"]
    passthrough = sum(1 for e in skills.values() if e.get("interface") is None)
    _out("skills: %d indexed (%d pass-through)" % (len(skills), passthrough))
    roots = scan_roots(os.getcwd())
    if roots:
        _out("roots:")
        for r in roots:
            _out("  %s" % r)
    else:
        _out("roots: none found")
    return 0 if claude else 1


def _filter(prefix, pairs):
    return [(c, d) for c, d in pairs if c.startswith(prefix)]


def _skill_line(entry, words):
    cur = words[-1]
    interface = entry.get("interface")
    taken = all_flag_names(interface) if interface else set()
    extras = []
    for mode in ("print", "app"):
        extras.append("--skl-" + mode if "--" + mode in taken else "--" + mode)
    if len(words) == 1:
        if interface is None:
            return _filter(cur, [("--help", ""), ("--print", ""), ("--app", "")])
        return _filter(cur, [(n, a.get("description", "")) for n, a in interface["actions"].items()])
    if interface is None or words[0] not in interface["actions"]:
        return []
    action = words[0]
    flags = flags_for(interface, action)
    if len(words) >= 3:
        prev = words[-2]
        for f in flags:
            if prev in f["names"] and f["takes_value"]:
                return _filter(cur, [(ch, "") for ch in f.get("choices", [])])
    earlier = set(words[1:-1])
    out = [(f["names"][0], "") for f in flags if not earlier.intersection(f["names"])]
    out += [(x, "") for x in extras if x not in earlier]
    return _filter(cur, out)


def complete(index, words):
    skills = index.get("skills", {})
    if not words:
        return []
    cur = words[-1]
    if len(words) == 1:
        return _filter(cur, [(b, "") for b in _BUILTINS] + [(n, "") for n in sorted(skills)])
    first = words[0]
    if first in ("show", "remove", "run") and len(words) == 2:
        return _filter(cur, [(n, "") for n in sorted(skills)])
    if first == "completion":
        return _filter(cur, [("zsh", ""), ("bash", "")]) if len(words) == 2 else []
    if first == "run":
        first, words = words[1], words[1:]
        if first not in skills:
            return []
        return _skill_line(skills[first], words[1:])
    if first in _BUILTINS:
        return []
    if first in skills:
        return _skill_line(skills[first], words[1:])
    return []


def cmd_complete(args):
    try:
        words = args[1:] if args and args[0] == "--" else args
        try:
            index = load_index()
        except Exception:
            index = {"skills": {}}
        pairs = complete(index, list(words))
        sys.stdout.write("".join(c + ("\t" + d if d else "") + "\n" for c, d in pairs))
        sys.stdout.flush()
    except Exception:
        pass
    return 0


_COMMANDS = {"sync": cmd_sync, "import": cmd_import, "list": cmd_list,
             "show": cmd_show, "remove": cmd_remove, "doctor": cmd_doctor, "run": cmd_run}


def main(argv):
    try:
        if argv and argv[0] == "__complete":
            return cmd_complete(argv[1:])
        if argv and argv[0] in _COMMANDS:
            return _COMMANDS[argv[0]](argv[1:])
        if not argv or argv[0] in _BUILTINS:
            sys.stderr.write("error: unknown command\n")
            return 2
        return cmd_run(argv)
    except KeyboardInterrupt:
        return 130
    except UsageError as e:
        sys.stderr.write("error: %s\n" % e)
        return 2
    except (SklError, OSError) as e:
        if isinstance(e, OSError) and not isinstance(e, SklError):
            e = e.strerror or e
        sys.stderr.write("error: %s\n" % e)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
